<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource White}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand">
        
        <Label Text="Suíte Super Luxo"
               FontFamily="PlayfairDisplayVariableFontwght"
               FontSize="38"
               TextColor="{StaticResource Green}"
               HorizontalTextAlignment="Center"/>

        <Frame Margin="10">
            <HorizontalStackLayout>
                
                <HorizontalStackLayout Margin="0,0,10,0">
                    <Label Text="Adultos:"
                           Margin="0,0,10,0"/>
                    <Label Text="2" TextColor="{StaticResource Green}"/>
                </HorizontalStackLayout>
                
                <HorizontalStackLayout>
                    <Label Text="Crianças:"
                           Margin="0,0,10,0"/>
                    <Label Text="2" TextColor="{StaticResource Green}"/>
                </HorizontalStackLayout>
                
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="10">
            <Grid ColumnDefinitions="*,*,*"
                  RowDefinitions="Auto, Auto">

                <Label Grid.Row="0" Grid.Column="0" Text="Check-in:"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out:"/>
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia:"/>

                <Label Grid.Row="1" Grid.Column="0" Text="13/11/2026" 
                       TextColor="{StaticResource Green}"/>
                <Label Grid.Row="1" Grid.Column="1" Text="15/11/2026" 
                       TextColor="{StaticResource Green}"/>
                <Label Grid.Row="1" Grid.Column="2" Text="3"
                       TextColor="{StaticResource Green}"/>
            </Grid>
        </Frame>

        <Frame Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor total:"
                       Margin="0,0,10,0"/>
                <Label Text="R$ 750,00"
                       TextColor="{StaticResource Green}"/>
            </HorizontalStackLayout>
        </Frame>
        
        <Button Text="Voltar" Clicked="Button_Clicked"
                TextColor="{StaticResource White}"
                HorizontalOptions="Center"
                BackgroundColor="{StaticResource Green}"/>
        
    </VerticalStackLayout>
</ContentPage>
    
    <!--
    VerticalOptions="CenterAndExpand" - centralizar o conteúdo vertical ao meio da tela.
    -->